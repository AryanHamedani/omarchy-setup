#!/usr/bin/python3
"""Refresh RIPE Iran exclusions without altering Windscribe security settings."""
import fcntl
import ipaddress
import json
import os
from pathlib import Path
import re
import tempfile
import urllib.request

URL = 'https://stat.ripe.net/data/country-resource-list/data.json?resource=IR&v4_format=prefix'


def validated_ranges(payload):
    if payload.get('status') != 'ok':
        raise ValueError('RIPE did not return a successful result')
    result = []
    resources = payload['data']['resources']
    for family, version, minimum in [('ipv4', 4, 1000), ('ipv6', 6, 100)]:
        values = resources.get(family, [])
        if not minimum <= len(values) <= 10000:
            raise ValueError('Unexpected country-list size: ' + family)
        networks = []
        for value in values:
            network = ipaddress.ip_network(value)
            if network.version != version or not network.is_global or network.prefixlen < (8 if version == 4 else 16):
                raise ValueError('Unsafe network: ' + value)
            networks.append(network)
        result.extend(str(n) for n in ipaddress.collapse_addresses(networks))
    if len(result) > 4096:
        raise ValueError('List exceeds Windscribe 2.24.12 route capacity')
    return result


def replace_ranges(config, routes):
    pattern = r'^SplitTunnelingRoutes=(.*)$'
    matches = list(re.finditer(pattern, config, re.MULTILINE))
    if len(matches) != 1:
        raise ValueError('Expected exactly one existing SplitTunnelingRoutes entry')
    domains = []
    for entry in matches[0].group(1).split(','):
        entry = entry.strip()
        if not entry:
            continue
        try:
            ipaddress.ip_network(entry)
        except ValueError:
            if not re.fullmatch(r'[A-Za-z0-9.-]+', entry):
                raise ValueError('Unsupported hostname entry: ' + entry)
            domains.append(entry)
    if len(domains) > 50:
        raise ValueError('Too many hostname exceptions')
    return re.sub(pattern, 'SplitTunnelingRoutes=' + ', '.join(routes + domains), config, flags=re.MULTILINE)


def atomic_write(path, content):
    fd, name = tempfile.mkstemp(prefix='.iran-refresh-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def main():
    config = Path.home() / '.config/Windscribe/windscribe_cli.conf'
    with (config.parent / '.iran-refresh.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        with urllib.request.urlopen(URL, timeout=45) as response:
            data = response.read(2_000_001)
        if len(data) > 2_000_000:
            raise ValueError('Oversized RIPE response')
        routes = validated_ranges(json.loads(data))
        original = config.read_text()
        updated = replace_ranges(original, routes)
        if updated == original:
            print('Iran ranges unchanged:', len(routes))
            return
        atomic_write(config.with_suffix('.conf.before-iran-refresh'), original)
        atomic_write(config, updated)
        # The installed 2.24.12 CLI watches this file and reloads it automatically.
        # Its help no longer exposes the older "preferences reload" command.
        print('Updated Iran ranges:', len(routes))


if __name__ == '__main__':
    main()
