+    /// Exclusive sessions: turn the headless output off until a client
+    /// connects. Call once input is set up, since that binds to the output.
+    pub async fn park_until_session(&self) -> Result<()> {
+        let inner = self.inner.lock().await;
+        if !inner.exclusive_session {
+            return Ok(());
+        }
+        if !wayland::other_outputs_on(&inner.output_name) {
+            // A previous run ended mid-session and left the other outputs off.
+            tracing::warn!("No other output is on; reloading Hyprland's config to restore them");
+            crate::hyprland::reload().context("failed to reload Hyprland's config")?;
+        }
+        inner.park_headless_output();
+        drop(inner);
+        watch_config_reloads(Arc::clone(&self.inner));
