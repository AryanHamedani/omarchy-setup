+/// Query every output, including disabled ones, as JSON value (array).
+pub fn monitors_all() -> Result<serde_json::Value> {
+    let response = send_command("j/monitors all")?;
+    serde_json::from_str(&response).context("failed to parse Hyprland monitors JSON")
+}
+
+/// An enabled output's settings, kept so it can be turned back on as it was.
+#[derive(Debug, Clone, PartialEq)]
+pub struct OutputRule {
+    pub name: String,
+    mode: String,
+    position: String,
+    scale: f64,
+    transform: u8,
+}
+
+impl OutputRule {
+    /// Read the rule back from one entry of `j/monitors`.
+    pub fn from_monitor(monitor: &serde_json::Value) -> Result<Self> {
+        let name = monitor["name"]
+            .as_str()
+            .context("monitor has missing or invalid 'name'")?;
+        let field = |key: &str| {
+            monitor[key]
+                .as_f64()
+                .with_context(|| format!("output '{name}' has missing or invalid '{key}'"))
+        };
+        Ok(Self {
+            name: name.to_string(),
+            mode: format!(
+                "{}x{}@{:.3}",
+                field("width")?,
+                field("height")?,
+                field("refreshRate")?
+            ),
+            position: format!("{}x{}", field("x")?, field("y")?),
+            scale: field("scale")?,
+            transform: u8::try_from(field("transform")? as u64)
+                .context("output transform is out of range")?,
+        })
+    }
+
+    /// Turn the output back on with these settings.
+    pub fn apply(&self) -> Result<()> {
+        let legacy = format!(
+            "{},{},{},{},transform,{}",
+            self.name, self.mode, self.position, self.scale, self.transform
+        );
+        let lua = format!(
+            "hl.monitor({{ output = {}, mode = {}, position = {}, scale = {}, transform = {}, disabled = false }})",
+            lua_string(&self.name)?,
+            lua_string(&self.mode)?,
+            lua_string(&self.position)?,
+            self.scale,
+            self.transform
+        );
+        monitor_action(&legacy, &lua)
+    }
+}
+
+/// Query workspaces as JSON value (array).
+pub fn workspaces() -> Result<serde_json::Value> {
+    let response = send_command("j/workspaces")?;
+    serde_json::from_str(&response).context("failed to parse Hyprland workspaces JSON")
+}
+
+/// Switch to a workspace by id.
+pub fn focus_workspace(id: i64) -> Result<()> {
+    match send_action(&format!("dispatch workspace {id}")) {
+        Ok(()) => Ok(()),
+        // Lua-config Hyprland takes dispatchers as Lua.
+        Err(_) => send_action(&format!(
+            "dispatch hl.dsp.focus({{ workspace = \"{id}\" }})"
+        )),
+    }
+}
+
+/// Reload Hyprland's config, which also drops runtime monitor rules.
+pub fn reload() -> Result<()> {
+    send_action("reload")
+}
+
+/// Turn an output off. Hyprland moves its workspaces to the remaining outputs.
+pub fn disable_output(name: &str) -> Result<()> {
+    let lua = format!(
+        "hl.monitor({{ output = {}, disabled = true }})",
