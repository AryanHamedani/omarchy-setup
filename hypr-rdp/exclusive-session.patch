         if let Some(handle) = self.capture_handle.take() {
             let _ = handle.join();
         }
-        // Thread exited, Wayland connection closed. Safe to remove output.
+        // Thread exited, Wayland connection closed. Safe to remove output,
+        // once the outputs a session turned off are back on.
+        self.hand_back();
+        if self.exclusive_session && self.headless_guard.is_some() {
+            // Hyprland only removes an output that is on.
+            let (width, height) = self.resolution;
+            if let Err(error) =
+                resize_headless_output(&self.output_name, width, height, self.headless_scale)
+            {
+                tracing::warn!(%error, "Failed to turn the headless output on for removal");
+            }
+        }
         drop(self.headless_guard.take());
     }
+
+    /// Exclusive session start: turn the headless output on at the session's
+    /// size, then the other outputs off, so Hyprland moves every workspace and
+    /// window to it. The headless output comes first, so Hyprland is never
+    /// left without an output.
+    fn take_over(&mut self) -> Result<()> {
+        if !self.exclusive_session || self.session_active {
+            return Ok(());
+        }
+        // The workspace in front now stays in front on the headless output.
+        let workspace = active_workspace(|m| m["focused"].as_bool() == Some(true));
+        let (width, height) = self.resolution;
+        resize_headless_output(&self.output_name, width, height, self.headless_scale)?;
+        self.session_active = true;
+        self.output_layout.bump_output_epoch();
+        self.park_other_outputs_keeping(workspace)?;
+        self.output_layout
+            .update_from_output_with_presentation(&self.output_name, self.resolution)
+            .context("failed to refresh layout after taking over the outputs")
+    }
+
+    /// Park the other outputs, then bring `workspace` back in front: Hyprland
+    /// moves the parked outputs' workspaces over asynchronously, and the
+    /// headless output may show a fresh one meanwhile.
+    fn park_other_outputs_keeping(&mut self, workspace: Option<i64>) -> Result<()> {
+        self.park_other_outputs()?;
+        let all_moved = || {
+            crate::hyprland::workspaces()
+                .ok()
+                .is_some_and(|workspaces| {
+                    workspaces.as_array().is_some_and(|workspaces| {
+                        workspaces
+                            .iter()
+                            .all(|w| w["monitor"].as_str() == Some(self.output_name.as_str()))
+                    })
+                })
+        };
+        let deadline = std::time::Instant::now() + Duration::from_secs(5);
+        while !all_moved() && std::time::Instant::now() < deadline {
+            std::thread::sleep(Duration::from_millis(50));
+        }
+        let Some(id) = workspace else {
+            return Ok(());
+        };
+        // A reload settles its monitor changes after the event, which can put a
+        // fresh workspace in front later: hold `id` in front until it stays.
+        let name = self.output_name.clone();
+        let on_headless = |m: &serde_json::Value| m["name"].as_str() == Some(name.as_str());
+        let deadline = std::time::Instant::now() + Duration::from_secs(2);
+        let mut steady = 0;
+        while steady < 4 && std::time::Instant::now() < deadline {
+            if active_workspace(on_headless) == Some(id) {
+                steady += 1;
+            } else {
+                steady = 0;
+                if let Err(error) = crate::hyprland::focus_workspace(id) {
+                    tracing::warn!(%error, "Failed to bring the workspace in front");
+                    break;
+                }
+            }
+            std::thread::sleep(Duration::from_millis(100));
+        }
+        Ok(())
+    }
+
+    fn park_other_outputs(&mut self) -> Result<()> {
+        let monitors = crate::hyprland::monitors()?;
+        let others = monitors
+            .as_array()
+            .context("expected monitors array")?
+            .iter()
+            .filter(|m| m["name"].as_str() != Some(self.output_name.as_str()));
+        for monitor in others {
+            let rule = crate::hyprland::OutputRule::from_monitor(monitor)?;
+            tracing::info!(output = %rule.name, "Turning output off for the session");
+            crate::hyprland::disable_output(&rule.name)?;
+            if !self
+                .parked_outputs
+                .iter()
+                .any(|parked| parked.name == rule.name)
+            {
+                self.parked_outputs.push(rule);
+            }
+        }
+        Ok(())
+    }
+
+    /// Exclusive session end: turn the parked outputs back on as they were,
+    /// then the headless output off, so Hyprland moves everything back.
+    fn hand_back(&mut self) {
+        if !self.session_active {
+            return;
+        }
+        for rule in self.parked_outputs.drain(..) {
+            tracing::info!(output = %rule.name, "Turning output back on");
+            if let Err(error) = rule.apply() {
+                tracing::warn!(output = %rule.name, %error, "Failed to turn output back on");
+            }
+        }
+        self.session_active = false;
+        // Hyprland turns outputs on asynchronously; the headless output may only
+        // go off once another one is on.
+        let deadline = std::time::Instant::now() + Duration::from_secs(5);
+        while !wayland::other_outputs_on(&self.output_name) && std::time::Instant::now() < deadline
+        {
+            std::thread::sleep(Duration::from_millis(50));
+        }
+        self.park_headless_output();
+    }
+
+    fn park_headless_output(&self) {
+        if !self.exclusive_session || self.headless_guard.is_none() {
+            return;
+        }
+        // Hyprland must keep an output: never turn off the last one.
+        if !wayland::other_outputs_on(&self.output_name) {
+            tracing::warn!("Keeping the headless output on: no other output is on");
+            return;
+        }
+        if let Err(error) = crate::hyprland::disable_output(&self.output_name) {
+            tracing::warn!(%error, "Failed to turn the headless output off");
+        }
+    }
+
+    /// A config reload drops runtime monitor rules: put the outputs back in
+    /// the state the session left them in.
+    fn reapply_outputs(&mut self) {
+        if !self.exclusive_session || self.closed {
+            return;
+        }
+        if !self.session_active {
+            self.park_headless_output();
+            return;
+        }
+        let (width, height) = self.resolution;
+        let mode = format!("{width}x{height}@60");
+        let rule = wayland::headless_monitor_rule(&self.output_name, &mode, self.headless_scale);
+        if let Err(error) = crate::hyprland::keyword_monitor(&rule) {
+            tracing::warn!(%error, "Failed to restore the headless output after a config reload");
+        }
+        // The reload turned the parked outputs back on; outputs plugged in
+        // meanwhile are parked too.
+        // The reload hands the parked outputs their workspaces back and gives
+        // the headless output a fresh one; keep the returning one in front.
+        let name = self.output_name.clone();
+        let workspace = active_workspace(|m| m["name"].as_str() != Some(name.as_str()))
+            .or_else(|| active_workspace(|m| m["name"].as_str() == Some(name.as_str())));
+        if let Err(error) = self.park_other_outputs_keeping(workspace) {
+            tracing::warn!(%error, "Failed to turn outputs off after a config reload");
+        }
+    }
+}
+
+/// The active workspace of the first output matching `pick`.
+fn active_workspace(pick: impl Fn(&serde_json::Value) -> bool) -> Option<i64> {
+    let monitors = crate::hyprland::monitors().ok()?;
+    monitors.as_array()?.iter().find(|m| pick(m))?["activeWorkspace"]["id"].as_i64()
+}
+
+/// Re-apply exclusive-session output state whenever Hyprland reloads its config.
+fn watch_config_reloads(inner: Arc<Mutex<HyprDisplayInner>>) {
+    std::thread::spawn(move || {
+        let mut events = match crate::hyprland::EventStream::connect() {
+            Ok(events) => events,
+            Err(error) => {
+                tracing::warn!(%error, "Cannot watch Hyprland config reloads");
+                return;
+            }
+        };
+        loop {
+            match events.next_event(Duration::from_secs(1)) {
+                Ok(Some((event, _))) if event == "configreloaded" => {
+                    let mut inner = inner.blocking_lock();
+                    if inner.closed {
+                        return;
+                    }
+                    tracing::info!("Hyprland reloaded its config; restoring session outputs");
+                    inner.reapply_outputs();
+                }
+                Ok(_) => {
+                    if inner.blocking_lock().closed {
+                        return;
+                    }
+                }
+                Err(error) => {
+                    tracing::warn!(%error, "Stopped watching Hyprland config reloads");
+                    return;
+                }
+            }
+        }
+    });
 }
 
